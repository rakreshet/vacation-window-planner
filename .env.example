# Local development only. Replace this before exposing the app beyond your machine.
POSTGRES_PASSWORD=local-dev-only
# Optional host ports, if the defaults conflict with another local app:
# API_PORT=18080
# WEB_PORT=15173
# Optional browser API base path; the local Vite proxy uses /api by default:
# VITE_API_BASE_URL=/api
# Optional, initial tunable Phase 0 recommendation policy defaults:
# RECOMMENDATION_EFFICIENCY_WEIGHT=0.5
# RECOMMENDATION_DURATION_WEIGHT=0.3
# RECOMMENDATION_LENGTH_FIT_WEIGHT=0.2
# RECOMMENDATION_GENERATION_CAP=5000
# RECOMMENDATION_LENGTH_TOLERANCE_DAYS=2
# RECOMMENDATION_NEAR_DUPLICATE_OVERLAP_RATIO=0.8
# RECOMMENDATION_MATERIAL_SCORE_GAP=5
# RECOMMENDATION_DEFAULT_RESULT_COUNT=5
# RECOMMENDATION_ENGINE_VERSION=phase0-v1
# Optional. Structured search works without an interpretation provider.
# INTERPRET_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# For Grok instead, set INTERPRET_PROVIDER=xai and XAI_API_KEY.
# XAI_API_KEY=
# XAI_MODEL=grok-4.3
# Public-POC safeguards and retention:
# CORS_ORIGINS=["http://localhost:15173"]
# MAX_REQUEST_BYTES=65536
# SESSION_EXPIRY_DAYS=30
# SOURCE_TEXT_RETENTION_DAYS=30

# Optional, server-owned Phase 0.5 comparison policy:
# COMPARISON_VERSION=phase05-v1
# COMPARISON_SHIFT_DAYS=21
# COMPARISON_EXTRA_DAYS=7
# COMPARISON_MAX_LENGTH_DAYS=28
# COMPARISON_RESULT_LIMIT=3
# COMPARISON_GENERATION_CAP=2000
